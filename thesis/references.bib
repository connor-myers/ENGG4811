author = {Wolf, Thomas and Debut, Lysandre and Sanh, Victor and Chaumond, Julien and Clement Delangue and Moi, Anthony and Cistac, Pierric and Rault, Tim and Louf, Rémi and Morgan Funtowicz and Davison, Joe and Shleifer, Sam and Patrick von Platen and Ma, Clara and Jernite, Yacine and Plu, Julien and Xu, Canwen and Teven Le Scao and Gugger, Sylvain and Drame, Mariama and Lhoest, Quentin and Rush, Alexander M},
